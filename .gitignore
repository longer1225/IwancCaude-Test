# ── 环境与密钥 ──
.env
.env.*
!.env.example

# ── 虚拟环境 ──
.venv/
venv/
ENV/
env/

# ── Python 字节码 ──
__pycache__/
*.pyc
*.pyo
*.pyd

# ── 构建产物 ──
dist/
build/
*.egg-info/
eggs/
*.egg

# ── 工具缓存 ──
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── IDE ──
.vscode/
.idea/
.trae/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── 本地运行产物 ──
# 统一收在 runs/：日志、测试临时目录（runs/tmp）、pytest basetemp（runs/pytest-tmp）、
# 归档（runs/archive）。仓库根只留源码与配置。
runs/
*.log
logs/
workspace/
sandbox/
.iwan/
.kama/

# ── 测试临时目录 ──
# 受限环境（沙箱/服务账号）里系统临时目录不可写，tempfile 会退回 cwd；这里兜底忽略，
# 真正的约束是 tests/tmp_utils.py —— 所有 mkdtemp 都必须落在 runs/tmp 下。
iwan_daemon_*/
iwan_authd_*/
pytest-of-*/
tmp*/

# ── 本地配置 ──
config.local.toml
*.local.toml

# 注意：uv.lock **不忽略**——CI 用 `uv sync --frozen`，锁文件必须入库。
