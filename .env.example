# IwanClaude 环境配置模板
# 用法：copy .env.example .env，然后按需填写（完整说明见 README「配置 API Key」）
#
# 注意：
#   1. .env 已被 .gitignore 忽略，不会提交到 git；本文件（.env.example）才会提交
#   2. 优先级：~/.iwan/secrets.env（GUI 写入） > Windows 环境变量 > 本文件 > config.toml > 代码默认值
#   3. 注释掉或留空的项，会先回落到 ~/.iwan/config.toml，最终回落到代码默认值
#   4. 本文件按设计【不含任何真实 Key】，请填你自己的

# ── Core Daemon 监听地址 ─────────────────────────────────────────────────
IWAN_HOST=127.0.0.1
IWAN_PORT=7437

# ── 日志 ──────────────────────────────────────────────────────────────────
IWAN_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
IWAN_LOG_FILE=~/.iwan/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
IWAN_LOG_FORMAT=text

# ── 指定额外的 TOML 配置文件路径（可选） ──────────────────────────────────
# IWAN_CONFIG=~/.iwan/config.toml

# ── LLM 模型（以 DeepSeek 官方 Anthropic 兼容端点为例） ──────────────────
# provider 与 base_url 必须配套，详见 README「协议约定」：
#   anthropic         → base_url 到 .../anthropic（SDK 自动补 /v1/messages）
#   openai_compatible → base_url 到 .../v1      （程序补 /chat/completions）
IWAN_LLM_PROVIDER=anthropic
IWAN_LLM_BASE_URL=https://api.deepseek.com/anthropic

# 从哪个【环境变量名】读 Key —— 这里只写变量名，不写值
# 推荐把 Key 放 Windows 用户级环境变量（不落盘）：
#   [System.Environment]::SetEnvironmentVariable("DEEPSEEK_API_KEY", "sk-你的Key", "User")
# 也可以直接在本文件里填值（明文，注意别外发）：
#   DEEPSEEK_API_KEY=sk-你的Key
IWAN_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=

# 模型名：deepseek-chat（快、便宜，默认） / deepseek-reasoner（推理强、慢、贵）
IWAN_LLM_DEFAULT_MODEL=deepseek-chat
# 模型 context window（deepseek-chat 为 128K，仅用于计算上下文占用百分比）
IWAN_LLM_CONTEXT_WINDOW=128000
# 默认档位：fast / balanced / powerful（详见 README「模型使用约定」）
# IWAN_MODEL_PRESET=balanced

# ── Agent 行为 ────────────────────────────────────────────────────────────
# 单次任务最大工具回合数，防止死循环
IWAN_MAX_STEPS=20

# ── 权限控制 ──────────────────────────────────────────────────────────────
# ask（每次询问） / auto_allow（全部允许） / auto_deny（全部拒绝）
# IWAN_PERMISSION_POLICY=ask
# 等待用户审批的超时时间（秒），超时视为拒绝
# IWAN_PERMISSION_TIMEOUT_S=60

# ── 上下文压缩（默认关闭） ────────────────────────────────────────────────
# 自动 compact 阈值（0.0=关闭，0.9=上下文占 90% 时触发）
# IWAN_COMPACT_THRESHOLD=0.0
# IWAN_COMPACT_TOOL_LIMIT=32768
# IWAN_COMPACT_TOOL_KEEP=2048

# ── 可选：GitHub PR 功能 ──────────────────────────────────────────────────
# 需要该仓库 repo 权限的 token；不配只影响 PR 功能，其余正常
# IWAN_GITHUB_TOKEN=

# ── 可选：知识库检索的 Embedding Key ─────────────────────────────────────
# 千问 / DashScope 的 Key，按以下任一变量名放；不配则检索功能不可用，不影响聊天
# QIANWEN_API_KEY=
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=

# ── 可选：语音识别 / HuggingFace 镜像 ────────────────────────────────────
# 语音识别模型档位
# IWAN_SPEECH_MODEL=small
# 直连 huggingface.co 不可达时走国内镜像
# HF_ENDPOINT=https://hf-mirror.com
